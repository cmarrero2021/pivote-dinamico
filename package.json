{
  "name": "dash-pivot",
  "version": "0.1.0",
  "description": "Reusable dynamic pivot dashboard (table + charts + saved queries) for Vue 3 + Quasar frontends and Node/Express + PostgreSQL backends. Schema/table-agnostic: data sources and fields are registered at runtime from the host application.",
  "main": "src/backend/index.js",
  "exports": {
    ".": "./src/backend/index.js",
    "./frontend": "./src/frontend/index.js",
    "./frontend/*": "./src/frontend/*",
    "./backend/*": "./src/backend/*"
  },
  "files": [
    "src",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "test": "echo \"No tests yet\" && exit 0"
  },
  "keywords": [
    "dashboard",
    "pivot",
    "pivot-table",
    "quasar",
    "vue3",
    "graphql",
    "dynamic-queries",
    "bi"
  ],
  "license": "MIT",
  "peerDependencies": {
    "express": "^4.19.2",
    "graphql": "^16.14.2",
    "graphql-http": "^1.23.1",
    "pg": "^8.23.1"
  },
  "peerDependenciesMeta": {
    "express": {
      "optional": false
    },
    "graphql": {
      "optional": false
    },
    "graphql-http": {
      "optional": false
    },
    "pg": {
      "optional": true
    }
  },
  "devDependencies": {
    "express": "^4.19.2",
    "graphql": "^16.14.2",
    "graphql-http": "^1.23.1",
    "pg": "^8.23.1"
  },
  "engines": {
    "node": ">=18"
  }
}
